# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，禁止提交。
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-me-base64-at-least-32-bytes
CORS_ALLOWED_ORIGINS=https://your-domain.example
# 每日限发等日期逻辑的时区；国内部署保持 Asia/Shanghai
USER_CENTER_TIME_ZONE=Asia/Shanghai
MYSQL_PORT=3306
REDIS_PORT=6379
HTTP_PORT=80
