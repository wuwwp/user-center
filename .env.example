# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，禁止提交。
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-me-base64-at-least-32-bytes
CORS_ALLOWED_ORIGINS=https://your-domain.example
# 每日限发等日期逻辑的时区；国内部署保持 Asia/Shanghai
USER_CENTER_TIME_ZONE=Asia/Shanghai
# SMTP：MAIL_MODE=log 时验证码只写日志；生产用 smtp，并填写真实授权码
MAIL_MODE=smtp
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-account@qq.com
MAIL_PASSWORD=your-smtp-authorization-code
MAIL_FROM=your-account@qq.com
MAIL_FROM_NAME=用户中心
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
MYSQL_PORT=3306
REDIS_PORT=6379
HTTP_PORT=80
