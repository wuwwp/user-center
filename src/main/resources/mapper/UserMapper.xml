<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wwp.usercenter.mapper.UserMapper">

    <select id="selectAuthStateById" resultType="com.wwp.usercenter.model.entity.User">
        select id, role, status, is_delete, token_version
        from `user`
        where id = #{userId}
    </select>

    <select id="selectCurrentUserById" resultType="com.wwp.usercenter.model.entity.User">
        select id, user_account, nickname, email, role, is_delete
        from `user`
        where id = #{userId}
    </select>

    <select id="selectAdminUserPage" resultType="com.wwp.usercenter.model.entity.User">
        select user_account, nickname, email, role, status, create_time, last_login_time
        from `user`
        where is_delete = 0
        <if test="status != null">
            and status = #{status}
        </if>
        order by id desc
    </select>

    <select id="selectAdminStateByAccount" resultType="com.wwp.usercenter.model.entity.User">
        select id, status
        from `user`
        where user_account = #{account}
          and is_delete = 0
    </select>

    <select id="selectLifecycleStateById" resultType="com.wwp.usercenter.model.entity.User">
        select id, email, role, status, is_delete, token_version
        from `user`
        where id = #{userId}
    </select>

    <select id="selectRecoverStateByEmail" resultType="com.wwp.usercenter.model.entity.User">
        select id, email, role, status, is_delete, token_version
        from `user`
        where email = #{email}
    </select>

    <select id="selectAccountsByIds" resultType="com.wwp.usercenter.model.entity.User">
        select id, user_account
        from `user`
        where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <sql id="tokenVersionIncrement">token_version = token_version + 1</sql>
    <sql id="passwordAssignment">password_hash = #{passwordHash}</sql>

    <update id="updateStatusAndIncrementTokenVersion">
        update `user`
        set status = #{status},
            <include refid="tokenVersionIncrement"/>
        where id = #{userId}
          and is_delete = 0
    </update>

    <update id="softDeleteAccount">
        update `user`
        set is_delete = 1,
            <include refid="tokenVersionIncrement"/>
        where id = #{userId}
          and is_delete = 0
          and status = 0
    </update>

    <update id="recoverAccount">
        update `user`
        set is_delete = 0,
            <include refid="passwordAssignment"/>,
            <include refid="tokenVersionIncrement"/>
        where id = #{userId}
          and is_delete = 1
          and status = 0
    </update>

    <update id="updatePassword">
        update `user`
        set <include refid="passwordAssignment"/>,
            <include refid="tokenVersionIncrement"/>
        where id = #{userId}
    </update>

    <update id="incrementTokenVersion">
        update `user`
        set <include refid="tokenVersionIncrement"/>
        where id = #{userId}
    </update>

</mapper>
